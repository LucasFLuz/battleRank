# battleRank Backend Environment Variables

PORT=3333
NODE_ENV=development

# Conexão com o PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/battlerank?schema=public"

# URL permitida para requisições do Frontend (CORS)
CORS_ORIGIN="http://localhost:5173"
