generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  email          String           @unique @db.VarChar(255)
  passwordHash   String           @map("password_hash") @db.VarChar(255)
  name           String           @db.VarChar(100)
  avatarUrl      String?          @map("avatar_url")
  xp             Int              @default(0)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  passwordResets PasswordReset[]
  refreshTokens  RefreshToken[]
  workouts       Workout[]
  followers      Follow[]         @relation("UserFollowers")
  following      Follow[]         @relation("UserFollowing")
  likes          SessionLike[]
  comments       SessionComment[]

  @@map("users")
}

model PasswordReset {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  token      String    @unique @db.VarChar(255)
  code       String    @db.VarChar(6)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Workout {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  name         String           @db.VarChar(100)
  goal         Goal
  level        Level
  modality     Modality         @default(MUSCULACAO)
  notes        String?
  scheduleType ScheduleType     @default(FLEXIBLE)
  daysOfWeek   Int[]            @default([])
  frequency    Int?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  exercises    Exercise[]
  sessions     WorkoutSession[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workouts")
}

model Exercise {
  id          String        @id @default(uuid()) @db.Uuid
  workoutId   String        @map("workout_id") @db.Uuid
  name        String        @db.VarChar(100)
  modality    Modality      @default(MUSCULACAO)
  sets        Int           @default(3)
  repetitions Int           @default(10)
  weight      Float?
  restTime    Int?          @map("rest_time")
  notes       String?
  order       Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  logs        ExerciseLog[]
  workout     Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@map("exercises")
}

model WorkoutSession {
  id              String           @id @default(uuid()) @db.Uuid
  workoutId       String           @map("workout_id") @db.Uuid
  startedAt       DateTime         @default(now()) @map("started_at")
  endedAt         DateTime?        @map("ended_at")
  durationSeconds Int?             @map("duration_seconds")
  totalVolume     Float            @default(0) @map("total_volume")
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  logs            ExerciseLog[]
  likes           SessionLike[]
  comments        SessionComment[]
  workout         Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@map("workout_sessions")
}

model ExerciseLog {
  id               String         @id @default(uuid()) @db.Uuid
  sessionId        String         @map("session_id") @db.Uuid
  exerciseId       String         @map("exercise_id") @db.Uuid
  setNumber        Int            @map("set_number")
  weight           Float
  repetitions      Int
  isCompleted      Boolean        @default(true) @map("is_completed")
  isPersonalRecord Boolean        @default(false) @map("is_personal_record")
  createdAt        DateTime       @default(now()) @map("created_at")
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  session          WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("exercise_logs")
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model SessionLike {
  id        String         @id @default(uuid()) @db.Uuid
  sessionId String         @map("session_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")

  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("session_likes")
}

model SessionComment {
  id        String         @id @default(uuid()) @db.Uuid
  sessionId String         @map("session_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  content   String         @db.VarChar(500)
  createdAt DateTime       @default(now()) @map("created_at")

  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session_comments")
}

enum Goal {
  HIPERTROFIA
  EMAGRECIMENTO
  RESISTENCIA
  FORCA
}

enum Level {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

enum ScheduleType {
  FIXED_DAYS
  FLEXIBLE
}

enum Modality {
  MUSCULACAO
  CROSSFIT
  CALISTENIA
  POWERLIFTING
  STRONGMAN
  FISICULTURISMO
  CARDIO
  CAMINHADA
  CORRIDA
  NATACAO
  CICLISMO
  TRIATLON
  REMO
  ELIPTICO
  ESCADA
  PULAR_CORDA
  FUTEBOL
  BASQUETE
  VOLEI
  HANDEBOL
  FUTSAL
  BEACH_TENNIS
  PADEL
  TENIS
  SQUASH
  BADMINTON
  MESA_TENIS
  BOXE
  MMA
  JIU_JITSU
  JUDO
  MUAY_THAI
  KARATE
  TAEKWONDO
  WRESTLING
  FUNCIONAL
  YOGA
  PILATES
  MOBILIDADE
  ALONGAMENTO
  ANIMAL_FLOW
  OUTROS
}
