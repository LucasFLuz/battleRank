// Prisma Schema para battleRank
// AC1: Mapeamento de Treinos (workouts)
// AC2: Exercícios (exercises), Sessões de Treino (workout_sessions) e Logs de Execução (exercise_logs)
// Estrutura modular preparada para expansão (AC3 e Prova Final)

generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Goal {
  HIPERTROFIA
  EMAGRECIMENTO
  RESISTENCIA
  FORCA
}

enum Level {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

enum ScheduleType {
  FIXED_DAYS     // Dias fixos da semana (ex: Seg, Qua, Sex)
  FLEXIBLE       // Frequência semanal livre (ex: 3x/semana)
}

enum Modality {
  // Força / Musculação
  MUSCULACAO
  CROSSFIT
  CALISTENIA
  POWERLIFTING
  STRONGMAN
  FISICULTURISMO

  // Cardio / Endurance
  CARDIO
  CAMINHADA
  CORRIDA
  NATACAO
  CICLISMO
  TRIATLON
  REMO
  ELIPTICO
  ESCADA
  PULAR_CORDA

  // Esportes Coletivos
  FUTEBOL
  BASQUETE
  VOLEI
  HANDEBOL
  FUTSAL
  BEACH_TENNIS
  PADEL

  // Esportes de Raquete
  TENIS
  SQUASH
  BADMINTON
  MESA_TENIS

  // Lutas / Artes Marciais
  BOXE
  MMA
  JIU_JITSU
  JUDO
  MUAY_THAI
  KARATE
  TAEKWONDO
  WRESTLING

  // Funcional / Mobilidade
  FUNCIONAL
  YOGA
  PILATES
  MOBILIDADE
  ALONGAMENTO
  ANIMAL_FLOW

  // Outros
  OUTROS
}

// ==========================================
// MODELOS PRINCIPAIS
// ==========================================

model Workout {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @db.VarChar(100)
  goal          Goal
  level         Level
  modality      Modality     @default(MUSCULACAO)
  notes         String?      @db.Text
  scheduleType  ScheduleType @default(FLEXIBLE)
  daysOfWeek    Int[]        @default([])  // 0=Dom, 1=Seg, ..., 6=Sáb
  frequency     Int?         // Vezes por semana (para FLEXIBLE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relacionamentos da AC2
  exercises Exercise[]
  sessions  WorkoutSession[]

  @@map("workouts")
}

model Exercise {
  id          String   @id @default(uuid()) @db.Uuid
  workoutId   String   @map("workout_id") @db.Uuid
  name        String   @db.VarChar(100)
  modality    Modality @default(MUSCULACAO)
  sets        Int      @default(3)
  repetitions Int      @default(10)
  weight      Float?
  restTime    Int?     @map("rest_time") // Tempo de descanso em segundos (ex: 60)
  notes       String?  @db.Text
  order       Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workout Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  logs    ExerciseLog[]

  @@map("exercises")
}

model WorkoutSession {
  id              String    @id @default(uuid()) @db.Uuid
  workoutId       String    @map("workout_id") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")
  totalVolume     Float     @default(0) @map("total_volume") // Carga total: series x reps x peso
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  workout Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  logs    ExerciseLog[]

  @@map("workout_sessions")
}

model ExerciseLog {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  exerciseId       String   @map("exercise_id") @db.Uuid
  setNumber        Int      @map("set_number")
  weight           Float
  repetitions      Int
  isCompleted      Boolean  @default(true) @map("is_completed")
  isPersonalRecord Boolean  @default(false) @map("is_personal_record")
  createdAt        DateTime @default(now()) @map("created_at")

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("exercise_logs")
}
